{
  "name": "@kepler.gl/mcp",
  "author": "Shan He <heshan0131@gmail.com>",
  "version": "3.3.0-alpha.19",
  "description": "The kepler.gl map surface for AI agents: map.* commands, command contract + JSON Schemas + types, a stdio MCP server that bridges to an open kepler.gl page, and the kepler map-management skill",
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "kepler-mcp": "dist/cjs/server/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/esm/server/index.js",
      "require": "./dist/cjs/server/index.js",
      "default": "./dist/cjs/server/index.js"
    },
    "./skill/kepler/SKILL.md": "./skill/kepler/SKILL.md",
    "./skill/kepler/skill.yaml": "./skill/kepler/skill.yaml"
  },
  "keywords": [
    "kepler",
    "kepler.gl",
    "map",
    "mcp",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/keplergl/kepler.gl.git"
  },
  "scripts": {
    "build": "rm -fr dist && babel src --out-dir dist/cjs --source-maps inline --extensions '.ts,.tsx,.js,.jsx' --ignore '**/*.d.ts,**/*.spec.ts,**/*.test.ts' && BABEL_ENV=esm babel src --out-dir dist/esm --source-maps inline --extensions '.ts,.tsx,.js,.jsx' --ignore '**/*.d.ts,**/*.spec.ts,**/*.test.ts'",
    "build:types": "tsc --project ./tsconfig.production.json",
    "prepublishOnly": "babel-node ../../scripts/license-header/bin --license ../../FILE-HEADER && yarn build && yarn build:types",
    "stab": "mkdir -p dist/cjs dist/esm && echo \"'use strict'; Object.assign(module.exports, require('../../src'));\" > dist/cjs/index.js && echo \"export * from '../../src';\" > dist/esm/index.js"
  },
  "files": [
    "dist",
    "skill"
  ],
  "dependencies": {
    "@kepler.gl/actions": "3.3.0-alpha.19",
    "@kepler.gl/constants": "3.3.0-alpha.19",
    "@kepler.gl/layers": "3.3.0-alpha.19",
    "@kepler.gl/processors": "3.3.0-alpha.19",
    "@kepler.gl/reducers": "3.3.0-alpha.19",
    "@kepler.gl/table": "3.3.0-alpha.19",
    "@kepler.gl/types": "3.3.0-alpha.19",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "apache-arrow": "^17.0.0",
    "ws": "^8.22.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.12.1",
    "@babel/node": "^7.12.1",
    "@types/ws": "^8.18.2"
  },
  "nyc": {
    "sourceMap": false,
    "instrument": false
  },
  "maintainers": [
    "Shan He <heshan0131@gmail.com>",
    "Igor Dykhta <dikhta.igor@gmail.com>",
    "Ilya Boyandin <ilya@boyandin.me>",
    "Xun Li <lixun910@gmail.com>"
  ],
  "engines": {
    "node": ">=20"
  },
  "volta": {
    "node": "20.19.3",
    "yarn": "4.4.0"
  },
  "packageManager": "yarn@4.4.0",
  "module": "dist/esm/index.js"
}
