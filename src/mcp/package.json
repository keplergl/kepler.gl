{
  "name": "@kepler.gl/mcp",
  "author": "Shan He <heshan0131@gmail.com>",
  "version": "3.3.0-alpha.8",
  "description": "The kepler.gl map surface for AI agents: map.* commands, command contract + JSON Schemas + types, and the kepler map-management skill",
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./skill/kepler/SKILL.md": "./skill/kepler/SKILL.md"
  },
  "keywords": [
    "kepler",
    "kepler.gl",
    "map",
    "mcp",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/keplergl/kepler.gl.git"
  },
  "scripts": {
    "build": "rm -fr dist && babel src --out-dir dist/cjs --source-maps inline --extensions '.ts,.tsx,.js,.jsx' --ignore '**/*.d.ts' && BABEL_ENV=esm babel src --out-dir dist/esm --source-maps inline --extensions '.ts,.tsx,.js,.jsx' --ignore '**/*.d.ts'",
    "build:types": "tsc --project ./tsconfig.production.json",
    "prepublishOnly": "babel-node ../../scripts/license-header/bin --license ../../FILE-HEADER && yarn build && yarn build:types",
    "stab": "mkdir -p dist/cjs dist/esm && echo \"'use strict'; Object.assign(module.exports, require('../../src'));\" > dist/cjs/index.js && echo \"export * from '../../src';\" > dist/esm/index.js"
  },
  "files": [
    "dist",
    "skill"
  ],
  "dependencies": {
    "@kepler.gl/actions": "3.3.0-alpha.8",
    "@kepler.gl/constants": "3.3.0-alpha.8",
    "@kepler.gl/layers": "3.3.0-alpha.8",
    "@kepler.gl/processors": "3.3.0-alpha.8",
    "@kepler.gl/reducers": "3.3.0-alpha.8",
    "@kepler.gl/table": "3.3.0-alpha.8",
    "@kepler.gl/types": "3.3.0-alpha.8",
    "apache-arrow": ">=15.0.0",
    "zod": "^4.4.0"
  },
  "nyc": {
    "sourceMap": false,
    "instrument": false
  },
  "maintainers": [
    "Shan He <heshan0131@gmail.com>",
    "Igor Dykhta <dikhta.igor@gmail.com>",
    "Ilya Boyandin <ilya@boyandin.me>",
    "Xun Li <lixun910@gmail.com>"
  ],
  "engines": {
    "node": ">=20"
  },
  "volta": {
    "node": "20.19.3",
    "yarn": "4.4.0"
  },
  "packageManager": "yarn@4.4.0",
  "module": "dist/esm/index.js"
}
