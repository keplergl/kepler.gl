{
  "name": "@kepler.gl/processors",
  "author": "Shan He <shan@uber.com>",
  "version": "3.3.0-alpha.21",
  "description": "kepler.gl constants used by kepler.gl components, actions and reducers",
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "babel",
    "es6",
    "react",
    "webgl",
    "visualization",
    "deck.gl"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/keplergl/kepler.gl.git"
  },
  "scripts": {
    "build": "rm -fr dist && babel src --out-dir dist/cjs --source-maps true --extensions '.ts,.tsx,.js,.jsx' --ignore '**/*.d.ts,**/*.spec.ts,**/*.spec.tsx,**/*.spec.js,**/*.spec.jsx,**/*.test.ts,**/*.test.tsx,**/*.test.js,**/*.test.jsx' && BABEL_ENV=esm babel src --out-dir dist/esm --source-maps true --extensions '.ts,.tsx,.js,.jsx' --ignore '**/*.d.ts,**/*.spec.ts,**/*.spec.tsx,**/*.spec.js,**/*.spec.jsx,**/*.test.ts,**/*.test.tsx,**/*.test.js,**/*.test.jsx'",
    "build:types": "tsc --project ./tsconfig.production.json",
    "prepublishOnly": "babel-node ../../scripts/license-header/bin --license ../../FILE-HEADER && yarn build && yarn build:types",
    "stab": "mkdir -p dist/cjs dist/esm && touch dist/cjs/index.js dist/esm/index.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@deck.gl-community/editable-layers": "10.0.0-alpha.1",
    "@kepler.gl/common-utils": "3.3.0-alpha.21",
    "@kepler.gl/constants": "3.3.0-alpha.21",
    "@kepler.gl/layers": "3.3.0-alpha.21",
    "@kepler.gl/schemas": "3.3.0-alpha.21",
    "@kepler.gl/table": "3.3.0-alpha.21",
    "@kepler.gl/types": "3.3.0-alpha.21",
    "@kepler.gl/utils": "3.3.0-alpha.21",
    "@loaders.gl/archives": "5.0.0-beta.8",
    "@loaders.gl/core": "5.0.0-beta.8",
    "@loaders.gl/excel": "^4.4.5",
    "@loaders.gl/geospatial": "5.0.0-beta.8",
    "@loaders.gl/tables": "5.0.0-beta.8",
    "@mapbox/geojson-normalize": "0.0.1",
    "@turf/helpers": "^7.2.0",
    "apache-arrow": ">=17.0.0",
    "d3-dsv": "^2.0.0",
    "parquet-wasm": "0.6.1",
    "sql.js": "1.13.0",
    "type-analyzer": "0.4.0"
  },
  "nyc": {
    "sourceMap": false,
    "instrument": false
  },
  "maintainers": [
    "Shan He <heshan0131@gmail.com>",
    "Giuseppe Macri <gmacri@uber.com>",
    "Igor Dykhta <dikhta.igor@gmail.com>",
    "Xun Li <lixun910@gmail.com>"
  ],
  "engines": {
    "node": ">=20"
  },
  "volta": {
    "node": "24.21.0",
    "yarn": "4.4.0"
  },
  "packageManager": "yarn@4.4.0",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "devDependencies": {
    "@types/sql.js": "^1"
  }
}
