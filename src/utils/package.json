{
  "name": "@kepler.gl/utils",
  "author": "Shan He <shan@uber.com>",
  "version": "3.3.0-alpha.6",
  "description": "kepler.gl constants used by kepler.gl components, actions and reducers",
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "babel",
    "es6",
    "react",
    "webgl",
    "visualization",
    "deck.gl"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/keplergl/kepler.gl.git"
  },
  "scripts": {
    "build": "rm -fr dist && babel src --out-dir dist/cjs --source-maps inline --extensions '.ts,.tsx,.js,.jsx' --ignore '**/*.d.ts' && BABEL_ENV=esm babel src --out-dir dist/esm --source-maps inline --extensions '.ts,.tsx,.js,.jsx' --ignore '**/*.d.ts'",
    "build:types": "tsc --project ./tsconfig.production.json",
    "prepublishOnly": "babel-node ../../scripts/license-header/bin --license ../../FILE-HEADER && yarn build && yarn build:types",
    "stab": "mkdir -p dist/cjs dist/esm && touch dist/cjs/index.js dist/esm/index.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@deck.gl/core": "^9.3.1",
    "@kepler.gl/common-utils": "3.3.0-alpha.6",
    "@kepler.gl/constants": "3.3.0-alpha.6",
    "@kepler.gl/types": "3.3.0-alpha.6",
    "@loaders.gl/gis": "^4.4.1",
    "@luma.gl/constants": "^9.3.2",
    "@luma.gl/core": "^9.3.2",
    "@mapbox/geo-viewport": "^0.4.1",
    "@turf/boolean-within": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "@types/d3-array": "^2.8.0",
    "@types/keymirror": "^0.1.1",
    "@types/lodash": "4.17.24",
    "apache-arrow": ">=15.0.0",
    "d3-array": "^2.8.0",
    "d3-color": "^3.1.0",
    "d3-format": "^2.0.0",
    "d3-interpolate": "^3.0.1",
    "decimal.js": "^10.2.0",
    "global": "^4.3.0",
    "h3-js": "^4.4.0",
    "keymirror": "^0.1.1",
    "lodash": "4.18.1",
    "mapbox-gl": "1.13.1",
    "maplibre-gl": "^4.0.0",
    "maplibregl-mapbox-request-transformer": "^0.0.2",
    "moment": "^2.10.6",
    "moment-timezone": "^0.5.35",
    "react": "^19.0.0",
    "react-map-gl": "^8.1.1",
    "resize-observer-polyfill": "^1.5.1",
    "suncalc": "^1.9.0",
    "type-analyzer": "0.4.0",
    "viewport-mercator-project": "^6.0.0"
  },
  "nyc": {
    "sourceMap": false,
    "instrument": false
  },
  "maintainers": [
    "Shan He <heshan0131@gmail.com>",
    "Giuseppe Macri <gmacri@uber.com>",
    "Igor Dykhta <dikhta.igor@gmail.com>",
    "Xun Li <lixun910@gmail.com>"
  ],
  "engines": {
    "node": ">=20"
  },
  "volta": {
    "node": "20.19.3",
    "yarn": "4.4.0"
  },
  "packageManager": "yarn@4.4.0",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  }
}
